...@../../../diagrams/_theme.d2

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

# ── I/O ────────────────────────────────────────────────────
game_start: "Game\nStart" { class: in }
out: "Out\n(tournament results)" { class: out }

# ── Tournament Runner ───────────────────────────────────────
runner: "Tournament\nRunner" { class: code }

# ── Game Engine ────────────────────────────────────────────
engine: "Game Engine (Moderator)" {
  style: { fill: "#f0f4ff"; stroke: "#4a6fa5"; border-radius: 6 }
  direction: right

  night_phase: "Night Phase" {
    style: { fill: "#e8eaf6"; stroke: "#3949ab"; border-radius: 5 }
    direction: down
    np_wolf: "Werewolf Kill" { class: code }
    np_seer: "Seer Investigation" { class: code }
    np_doc: "Doctor Protection" { class: code }
  }

  day_phase: "Day Phase" {
    style: { fill: "#e8f5e9"; stroke: "#2e7d32"; border-radius: 5 }
    direction: down

    bid_collect: "Bid Collection\n(0-5, simultaneous)" { class: code }
    discussion: "Discussion\n(2 speech rounds)" { class: code }
    vote_collect: "Vote Collection\n(name — reason)" { class: code }
    elimination: "Elimination &\nRole Reveal" { class: code }

    bid_collect -> discussion: "order by bid desc\n(bid=0 → pass)" { class: call }
    discussion -> bid_collect: "round 2 bids" {
      style: { stroke-dash: 3; animated: true }
    }
    discussion -> vote_collect: "after round 2" { class: call }
    vote_collect -> elimination { class: call }
  }

  check: "Win\nCondition" { class: code }

  night_phase -> day_phase { class: call }
  day_phase -> check { class: call }
  check -> night_phase: "next round" {
    style: { stroke-dash: 3; animated: true }
  }
}

# ── Metrics ─────────────────────────────────────────────────
metrics: "Metrics\nAggregator" { class: code }

# ══════════════════════════════════════════════════════════════
# AGENT PATTERNS
# ══════════════════════════════════════════════════════════════
agents: "Agent Pool" {
  style: { fill: "#f9f9f9"; stroke: "#aaaaaa"; border-radius: 6 }
  direction: down

  # ── 1. BASELINE ──────────────────────────────────────────
  baseline: "Baseline Agent" {
    style: { fill: "#f0f9ff"; stroke: "#4a6fa5"; border-radius: 5 }
    direction: right

    bl_bid: "bid()\nSingle LLM call\n→ parse [0-5]" { class: code }
    bl_speak: "speak()\nSingle LLM call\n→ text or PASS" { class: code }
    bl_vote: "vote()\nSingle LLM call\n→ name — reason" { class: code }
    bl_night: "night_action()\nSingle LLM call\n→ name" { class: code }
  }

  # ── 2. REFLECTION ────────────────────────────────────────
  reflection: "Reflection Agent" {
    style: { fill: "#f0fff4"; stroke: "#2e7d32"; border-radius: 5 }
    direction: down

    ref_bid: "bid()" {
      style: { fill: "#e8f5e9"; stroke: "#2e7d32"; border-radius: 4 }
      direction: right
      rb_draft: "Draft LLM\n→ [0-5]" { class: agent }
      rb_crit: "Critique LLM\n✓ strategic fit?\n✓ role hidden?\n✓ info level?\n✓ win probability?" { class: agent }
      rb_revise: "Revise LLM\n→ new bid value" { class: agent }
      rb_out: "bid value" { class: out }
      rb_draft -> rb_crit { class: call }
      rb_crit -> rb_revise: "REVISE\n(max 2x)" {
        style: { stroke: red; stroke-dash: 3; animated: true }
      }
      rb_revise -> rb_crit { class: call }
      rb_crit -> rb_out: "APPROVE" { class: call }
    }

    ref_speak: "speak()" {
      style: { fill: "#e8f5e9"; stroke: "#2e7d32"; border-radius: 4 }
      direction: right
      rs_draft: "Draft LLM\n→ text/PASS" { class: agent }
      rs_crit: "Critique LLM\n✓ consistent?\n✓ role hidden?\n✓ persuasive?\n✓ win probability?" { class: agent }
      rs_revise: "Revise LLM\n→ improved text" { class: agent }
      rs_out: "speech" { class: out }
      rs_draft -> rs_crit { class: call }
      rs_crit -> rs_revise: "REVISE\n(max 2x)" {
        style: { stroke: red; stroke-dash: 3; animated: true }
      }
      rs_revise -> rs_crit { class: call }
      rs_crit -> rs_out: "APPROVE" { class: call }
    }

    ref_vote: "vote()" {
      style: { fill: "#e8f5e9"; stroke: "#2e7d32"; border-radius: 4 }
      direction: right
      rv_draft: "Draft LLM\n→ name — reason" { class: agent }
      rv_crit: "Critique LLM\n✓ consistent?\n✓ role hidden?\n✓ persuasive?\n✓ win probability?" { class: agent }
      rv_revise: "Revise LLM\n→ better target" { class: agent }
      rv_out: "vote + reason" { class: out }
      rv_draft -> rv_crit { class: call }
      rv_crit -> rv_revise: "REVISE\n(max 2x)" {
        style: { stroke: red; stroke-dash: 3; animated: true }
      }
      rv_revise -> rv_crit { class: call }
      rv_crit -> rv_out: "APPROVE" { class: call }
    }

    ref_night: "night_action()" {
      style: { fill: "#e8f5e9"; stroke: "#2e7d32"; border-radius: 4 }
      direction: right
      rn_draft: "Draft LLM\n→ name" { class: agent }
      rn_crit: "Critique LLM\n✓ strategic?\n✓ role hidden?\n✓ win probability?" { class: agent }
      rn_revise: "Revise LLM\n→ better target" { class: agent }
      rn_out: "target" { class: out }
      rn_draft -> rn_crit { class: call }
      rn_crit -> rn_revise: "REVISE\n(max 2x)" {
        style: { stroke: red; stroke-dash: 3; animated: true }
      }
      rn_revise -> rn_crit { class: call }
      rn_crit -> rn_out: "APPROVE" { class: call }
    }
  }

  # ── 3. REACT ─────────────────────────────────────────────
  react: "ReAct Agent" {
    style: { fill: "#fff8e1"; stroke: "#f0a500"; border-radius: 5 }
    direction: down

    game_state_tools: "Game-State Tools" {
      class: cont_tools
      direction: right
      t1: "get_alive_players" {
        class: tool
        width: 180
        height: 50
      }
      t2: "get_voting_history" {
        class: tool
        width: 180
        height: 50
      }
      t3: "get_speech_log" {
        class: tool
        width: 180
        height: 50
      }
      t4: "get_elimination_history" {
        class: tool
        width: 180
        height: 50
      }
      t5: "get_suspicion_graph" {
        class: tool
        width: 180
        height: 50
      }
      t6: "get_player_summary" {
        class: tool
        width: 180
        height: 50
      }
    }

    all_actions: "All Four Actions" {
      style: { fill: "#fff8e1"; stroke: "#f0a500"; border-radius: 4 }
      direction: down

      react_loop: "ReAct Loop (max 4 steps)\nThought → Tool call → Observation → … → Action" {
        style: { fill: "#fff3cd"; stroke: "#f0a500"; border-radius: 4 }
        direction: right
        rl_think: "Thought\nLLM" { class: agent }
        rl_act: "Action\n(final answer)" { class: out }
        rl_think -> game_state_tools: "Tool: <name>(<arg>)" { class: call }
        game_state_tools -> rl_think: "Observation: <result>" { class: call }
        rl_think -> rl_act: "Action: <KEY>: <answer>" { class: call }
      }

      ra_bid: "bid()\noutput_key=BID\n→ parse [0-5]" { class: code }
      ra_speak: "speak()\noutput_key=SPEECH\n→ text or PASS" { class: code }
      ra_vote: "vote()\noutput_key=VOTE\n→ name — reason" { class: code }
      ra_night: "night_action()\noutput_key=ACTION\n→ name" { class: code }

      ra_bid -> react_loop { class: call }
      ra_speak -> react_loop { class: call }
      ra_vote -> react_loop { class: call }
      ra_night -> react_loop { class: call }
    }
  }

  # ── 4. TREE OF THOUGHTS ──────────────────────────────────
  tot: "Tree of Thoughts Agent" {
    style: { fill: "#fce4ec"; stroke: "#c62828"; border-radius: 5 }
    direction: down

    # BID
    tot_bid: "bid() — 2-phase branching" {
      style: { fill: "#fce4ec"; stroke: "#c62828"; border-radius: 4 }
      direction: right

      tb_p1: "Phase 1 — 4 parallel branches" {
        style: { fill: "#fff0f0"; stroke: "#c62828"; border-radius: 4 }
        direction: down
        tb_d1: "Branch 1: bid=0\n→ analysis" { class: agent }
        tb_d2: "Branch 2: bid=1-2\n→ analysis" { class: agent }
        tb_d3: "Branch 3: bid=3\n→ analysis" { class: agent }
        tb_d4: "Branch 4: bid=4-5\n→ analysis" { class: agent }
      }

      tb_eval1: "Evaluator 1\n→ BEST: <1/2/3/4>" { class: agent }

      tb_p2: "Phase 2 — 2 parallel branches\n(only if range selected)" {
        style: { fill: "#fff0f0"; stroke: "#c62828"; border-radius: 4; stroke-dash: 3 }
        direction: down
        tb_d5: "Branch A: bid=low\n→ analysis" { class: agent }
        tb_d6: "Branch B: bid=high\n→ analysis" { class: agent }
      }

      tb_eval2: "Evaluator 2\n→ exact number" { class: agent }
      tb_out: "bid value" { class: out }

      tb_p1 -> tb_eval1 { class: call }
      tb_eval1 -> tb_out: "single value\n(0 or 3)" { class: call }
      tb_eval1 -> tb_p2: "range selected\n(1-2 or 4-5)" {
        style: { stroke-dash: 3; animated: true }
      }
      tb_p2 -> tb_eval2 { class: call }
      tb_eval2 -> tb_out { class: call }
    }

    # SPEAK
    tot_speak: "speak() — 2-phase" {
      style: { fill: "#fce4ec"; stroke: "#c62828"; border-radius: 4 }
      direction: right

      ts_strat: "Strategist LLM\n→ 3 strategies" { class: agent }

      ts_p1: "Phase 1 — 3 parallel eval branches" {
        style: { fill: "#fff0f0"; stroke: "#c62828"; border-radius: 4 }
        direction: down
        ts_e1: "Branch 1\n→ strategy analysis" { class: agent }
        ts_e2: "Branch 2\n→ strategy analysis" { class: agent }
        ts_e3: "Branch 3\n→ strategy analysis" { class: agent }
      }

      ts_eval1: "Evaluator 1\n→ best strategy" { class: agent }

      ts_p2: "Phase 2 — 2 parallel text branches" {
        style: { fill: "#fff0f0"; stroke: "#c62828"; border-radius: 4 }
        direction: down
        ts_t1: "Branch A\n→ speech text" { class: agent }
        ts_t2: "Branch B\n→ speech text" { class: agent }
      }

      ts_eval2: "Evaluator 2\n→ best text" { class: agent }
      ts_out: "speech" { class: out }

      ts_strat -> ts_p1 { class: call }
      ts_p1 -> ts_eval1 { class: call }
      ts_eval1 -> ts_p2 { class: call }
      ts_p2 -> ts_eval2 { class: call }
      ts_eval2 -> ts_out { class: call }
    }

    # VOTE
    tot_vote: "vote() — 2-layer" {
      style: { fill: "#fce4ec"; stroke: "#c62828"; border-radius: 4 }
      direction: right

      tv_strat1: "Strategist 1\n→ 3 candidate names" { class: agent }

      tv_l1: "Layer 1 — 3 parallel scenario branches" {
        style: { fill: "#fff0f0"; stroke: "#c62828"; border-radius: 4 }
        direction: down
        tv_s1: "Branch 1\n→ scenario analysis" { class: agent }
        tv_s2: "Branch 2\n→ scenario analysis" { class: agent }
        tv_s3: "Branch 3\n→ scenario analysis" { class: agent }
      }

      tv_eval1: "Evaluator 1\n→ winning name" { class: agent }

      tv_strat2: "Strategist 2\n→ 3 candidate reasons" { class: agent }

      tv_l2: "Layer 2 — 3 parallel reason eval branches" {
        style: { fill: "#fff0f0"; stroke: "#c62828"; border-radius: 4 }
        direction: down
        tv_r1: "Branch 1\n→ reason analysis" { class: agent }
        tv_r2: "Branch 2\n→ reason analysis" { class: agent }
        tv_r3: "Branch 3\n→ reason analysis" { class: agent }
      }

      tv_eval2: "Evaluator 2\n→ best reason" { class: agent }
      tv_out: "name — reason" { class: out }

      tv_strat1 -> tv_l1 { class: call }
      tv_l1 -> tv_eval1 { class: call }
      tv_eval1 -> tv_strat2 { class: call }
      tv_strat2 -> tv_l2 { class: call }
      tv_l2 -> tv_eval2 { class: call }
      tv_eval2 -> tv_out { class: call }
    }

    # NIGHT ACTION
    tot_night: "night_action()" {
      style: { fill: "#fce4ec"; stroke: "#c62828"; border-radius: 4 }
      direction: right

      tn_strat: "Strategist LLM\n→ 3 candidate targets" { class: agent }

      tn_branches: "3 parallel scenario branches" {
        style: { fill: "#fff0f0"; stroke: "#c62828"; border-radius: 4 }
        direction: down
        tn_b1: "Branch 1\n→ scenario analysis" { class: agent }
        tn_b2: "Branch 2\n→ scenario analysis" { class: agent }
        tn_b3: "Branch 3\n→ scenario analysis" { class: agent }
      }

      tn_eval: "Evaluator\n→ best target" { class: agent }
      tn_out: "target" { class: out }

      tn_strat -> tn_branches { class: call }
      tn_branches -> tn_eval { class: call }
      tn_eval -> tn_out { class: call }
    }
  }
}

# ── Top-level flows ─────────────────────────────────────────
game_start -> runner: "schedule\nconfig" { class: io_call }
runner -> engine: "start game" { class: call }

engine -> agents: "prompt\n(bid / speak / vote / night)" { class: call }
agents -> engine: "action\n(number / text / name — reason)" { class: call }

engine.check -> metrics: "game result" { class: call }
runner -> metrics: "aggregate" { class: call }
metrics -> out: "win rate · detection accuracy\nvote accuracy · survival" { class: io_call }
